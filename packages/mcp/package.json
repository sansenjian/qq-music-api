{
	"name": "@sansenjian/qq-music-api-mcp",
	"version": "2.6.0",
	"description": "MCP server for @sansenjian/qq-music-api",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"bin": {
		"qq-music-api-mcp": "dist/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "vite build && node scripts/build-declarations.mjs",
		"dev": "tsx src/cli.ts",
		"start": "node dist/cli.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/sansenjian/qq-music-api.git",
		"directory": "packages/mcp"
	},
	"keywords": [
		"qq-music",
		"mcp",
		"model-context-protocol"
	],
	"author": "sansenjian",
	"license": "MIT",
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"axios": "^1.20.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"tsx": "^4.23.15",
		"vite": "^8.3.0",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": "^20.17.0 || >=22.9.0",
		"npm": "^11.0.0"
	}
}
